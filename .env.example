# Node.js 24+ required. Copy to .env; no keys are required for local use.
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# Empty by default. Set true ONLY for isolated development/test fixtures.
# Enabling this adds sample media and metrics on first startup of that DATA_DIR.
DEMO_MODE=false

# demo = local brightness/resolution/duplicate checks + Turkish caption templates.
# openai = multimodal frame/photo analysis + Turkish generation (falls back on error).
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional S3-compatible media storage. Empty bucket uses local .data/objects.
# Keep the bucket private. Files are served by the local application.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Instagram uses the mock adapter in server/instagram.mjs.
# There are intentionally no Instagram token fields in the application.
