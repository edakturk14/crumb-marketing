# Node.js 24+ required. Copy to .env; no keys are required for local use.
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
# Empty by default. Set true ONLY for isolated development/test fixtures.
# Enabling this adds sample media and metrics on first startup of that DATA_DIR.
DEMO_MODE=false

# Free-only mode: local image checks + Turkish caption templates.
# API keys do not enable paid AI. Setting a paid provider or S3_BUCKET stops startup.
AI_PROVIDER=demo

# Instagram tokens never appear in the app UI; see optional OAuth settings below.

# Hosted storage: enable only after verifying the actual Supabase Free Plan.
# STORAGE_PROVIDER=supabase
# SUPABASE_PLAN=free
# POSTGRES_URL= (provided by the Supabase integration)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_ACCESS_CODE_HASH= (SHA-256 of a randomly generated private access code)
# SESSION_SECRET= (random secret, at least 32 characters)

# Optional read-only Instagram OAuth. Get the *Instagram* app ID and secret
# from Meta > Instagram > API setup with Instagram login > Business login.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://YOUR-APP.vercel.app/api/instagram/callback
INSTAGRAM_API_VERSION=v25.0
# Local OAuth testing also needs a secure callback and a token encryption secret.
# INSTAGRAM_TOKEN_SECRET= (optional; defaults to SESSION_SECRET)
# Scopes are fixed in code: instagram_business_basic, instagram_business_manage_insights.
# No publishing, messages, comment management, Facebook Page or ads permissions.

# Google sign-in (Supabase Auth; same Free Plan, no password database in Crumb).
# Configure Google OAuth credentials in Supabase, then run scripts/check-google.mjs.
# Flip AUTH_PROVIDER only after the provider and allowed accounts are ready.
# AUTH_PROVIDER=google
# APP_ORIGIN=https://crumb-marketing-eight.vercel.app
# SUPABASE_PUBLISHABLE_KEY= (already supplied by the Vercel/Supabase integration)
# AUTH_ALLOWED_EMAILS=you@gmail.com,bakery-owner@gmail.com
# Comma-separated exact emails; no domains, wildcards or first-user claims.
# In Google mode APP_ACCESS_CODE_HASH and old access-code cookies are ignored.
# Keep SESSION_SECRET for encrypting the optional Instagram token.
