{
  "name": "cake-gallery-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write src server scripts tests index.html playwright.config.mjs package.json README.md docs/*.md",
    "format:check": "prettier --check src server scripts tests index.html playwright.config.mjs package.json README.md docs/*.md",
    "remove:samples": "node --env-file-if-exists=.env scripts/remove-samples.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "vite": "^7.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
